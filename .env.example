# 511 Open Data keys from https://511.org/open-data/token, comma separated.
# The server takes turns between keys. Each key allows 60 requests per hour per endpoint,
# and fetching trip updates every 30 seconds takes 120, so 3 keys leave room for restarts and retries.
# Use keys no other tool uses (such as the next-transit-home CLI or the LED display), since they would share the limit.
API_KEYS_511=

# Port the web server listens on.
PORT=3000
